# Resend API Key (Configured in Vercel Environment Variables)
# Obtain your API key from: https://resend.com/api-keys
# NEVER expose this key in client-side code or public variables.
RESEND_API_KEY=

# Optional: Verified sender email (defaults to 'onboarding@resend.dev' until domain is verified)
# Once domain is verified in Resend, change to: Ready to Respond <contact@readytorespond.ca>
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional: Business email destination for inquiries (defaults to readytorespond4u@gmail.com)
BUSINESS_EMAIL=readytorespond4u@gmail.com

# Admin Portal Password
ADMIN_PASSWORD=HTCeleron1?

# Vercel Blob / KV Storage (automatically provided by Vercel when connected)
BLOB_READ_WRITE_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
